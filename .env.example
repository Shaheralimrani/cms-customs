# تحذير / WARNING:
# انسخ هذا الملف إلى .env للإعداد المحلي.
# لا تضع كلمات مرور حقيقية في هذا الملف أو ترفعه إلى GitHub.
# Copy to .env for local development. Never commit real credentials.
# في الإنتاج: APP_ENV=production, APP_DEBUG=false

# إعدادات التطبيق / Application Settings
# البيئة الحالية: local للتطوير.
APP_ENV=local
# تفعيل عرض أخطاء PHP أثناء التطوير؛ عطّله في الإنتاج.
APP_DEBUG=true
# اسم التطبيق المعروض للمستخدم.
APP_NAME="نظام الجمارك"
# المنطقة الزمنية المستخدمة في التطبيق.
APP_TIMEZONE=Asia/Aden

# إعدادات قاعدة البيانات / Database Settings
# عنوان خادم MySQL المحلي.
DB_HOST=localhost
# منفذ MySQL في إعداد XAMPP الحالي.
DB_PORT=3307
# اسم قاعدة البيانات التي يستخدمها التطبيق.
DB_NAME=cms_db
# اسم مستخدم قاعدة البيانات المحلية.
DB_USER=root
# كلمة المرور المحلية؛ اتركها فارغة فقط إذا كان حساب MySQL بلا كلمة مرور.
DB_PASS=
# ترميز اتصال قاعدة البيانات.
DB_CHARSET=utf8mb4